{
  "compilerOptions": {
    "target": "es2017",
    "module": "commonjs",
    "removeComments": false,
    "preserveConstEnums": true,
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "noImplicitAny": false,
    "allowSyntheticDefaultImports": true,
    "outDir": "lib",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strictNullChecks": true,
    "sourceMap": true,
    "rootDir": ".",
    "jsx": "preserve",
    "allowJs": true,
    "resolveJsonModule": true,
    "paths": {
      "@/components/*": [
        "./src/components/*"
      ],
      "@/types/*": [
        "./src/types/*"
      ],
      "@/styles/*": [
        "./src/styles/*"
      ],
      "@/stores/*": [
        "./src/stores/*"
      ],
      "@/apis/*": [
        "./src/apis/*"
      ],
      "@/utils/*": [
        "./src/utils/*"
      ]
    },
    "typeRoots": [
      "node_modules/@types"
    ],
  },
  "include": [
    "./src",
    "./types",
    "components.d.ts"
  ],
  "compileOnSave": false
}
